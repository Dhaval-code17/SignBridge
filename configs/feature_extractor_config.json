{
    "project": "SignBridge",
    "role": "Person 1 - Visual Sign Recognition",
    "model": {
        "architecture": "MobileNetV3-Large",
        "checkpoint": "models/checkpoints/mobilenet_v3_stage2_best.pth",
        "feature_dimension": 960
    },
    "input": {
        "type": "video",
        "supported_format": "mp4",
        "frame_width": 224,
        "frame_height": 224,
        "channels": 3,
        "color_space": "RGB",
        "normalization": {
            "mean": [
                0.485,
                0.456,
                0.406
            ],
            "std": [
                0.229,
                0.224,
                0.225
            ]
        }
    },
    "temporal_processing": {
        "isolated_sign_num_frames": 16,
        "continuous_sample_fps": 8.0,
        "sampling_method": "uniform_temporal_sampling",
        "sequence_length": "variable_for_continuous_video"
    },
    "output": {
        "format": "numpy",
        "dtype": "float32",
        "isolated_sign_shape": [
            16,
            960
        ],
        "continuous_sign_shape": [
            "T",
            960
        ],
        "feature_normalization": "L2_per_frame"
    },
    "member_2_interface": {
        "input_file": "*.npy",
        "tensor_shape": "[T, 960]",
        "feature_dimension": 960,
        "temporal_dimension": "T",
        "classification_logits": "not provided",
        "visual_features_only": true
    },
    "deployment": {
        "onnx_model": "models/onnx/mobilenet_v3_stage2_encoder.onnx",
        "onnx_input": "[B, 3, 224, 224]",
        "onnx_output": "[B, 960]",
        "onnx_opset": 17
    }
}